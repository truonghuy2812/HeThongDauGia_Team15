<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right, #fffafa, #fce8e9, #f7d6d8);" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.AdminDepositManager">

    <!-- SIDEBAR BÊN TRÁI -->
    <left>
        <VBox prefWidth="280.0" style="-fx-background-color: #ffffff; -fx-border-color: #f2dce0; -fx-border-width: 0 1 0 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 12, 0, 2, 0);" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="ADMIN" textFill="#d31126">
                            <font>
                                <Font name="System Bold" size="26.0" />
                            </font>
                        </Label>
                        <Label text=" PANEL" textFill="#222222">
                            <font>
                                <Font name="System Regular" size="22.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="4.0" top="2.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>

                <VBox spacing="6.0">
                    <padding>
                        <Insets left="15.0" right="15.0" top="20.0" />
                    </padding>
                    <children>
                        <Label text="QUẢN LÝ HỆ THỐNG" textFill="#9ca3af">
                            <font>
                                <Font name="System Bold" size="12.0" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="5.0" left="8.0" />
                            </VBox.margin>
                        </Label>

                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#manageApproveAuctions" prefHeight="44.0" prefWidth="250.0" style="-fx-background-color: transparent; -fx-text-fill: #4b5563; -fx-background-radius: 5; -fx-cursor: hand;" text="⚖  Duyệt Phiên Đấu Giá">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="18.0" />
                            </padding>
                        </Button>

                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="250.0" style="-fx-background-color: #fce8e9; -fx-text-fill: #d31126; -fx-background-radius: 5; -fx-font-weight: bold; -fx-cursor: hand;" text="💵  Duyệt Lệnh Nạp Tiền">
                            <font>
                                <Font name="System Bold" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="18.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>

                <Region VBox.vgrow="ALWAYS" />

                <VBox spacing="15.0">
                    <padding>
                        <Insets bottom="20.0" left="24.0" right="24.0" />
                    </padding>
                    <children>
                        <Button fx:id="btnLogOut" mnemonicParsing="false" prefHeight="40.0" prefWidth="232.0" style="-fx-background-color: #ffffff; -fx-border-color: #d31126; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #d31126; -fx-font-weight: bold; -fx-cursor: hand;" styleClass="danger" text="🚪  Đăng Xuất">
                            <font>
                                <Font name="System Bold" size="13.5" />
                            </font>
                        </Button>
                        <VBox spacing="3.0">
                            <children>
                                <Label text="TEAM 15 © 2026." textFill="#9ca3af">
                                    <font>
                                        <Font name="System Regular" size="12.5" />
                                    </font>
                                </Label>
                                <Label text="Hệ thống quản trị đấu giá" textFill="#4b5563">
                                    <font>
                                        <Font name="System Regular" size="12.5" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- KHU VỰC CHÍNH BÊN PHẢI -->
    <center>
        <VBox style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <children>
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-background-color: #ffffff; -fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                    <children>
                        <Label text="Danh sách lệnh yêu cầu nạp tiền" textFill="#222222">
                            <font>
                                <Font name="System Regular" size="22.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox alignment="CENTER" spacing="8.0" style="-fx-background-color: #fffafa; -fx-border-color: #f2dce0; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 6 14 6 14;">
                            <children>
                                <SVGPath content="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" fill="transparent" scaleX="0.85" scaleY="0.85" stroke="#d31126" strokeWidth="1.5" />
                                <Label text="Quản trị viên" textFill="#374151">
                                    <font>
                                        <Font name="System Regular" size="13.0" />
                                    </font>
                                </Label>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <VBox spacing="20.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>
                        <VBox style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 4); -fx-padding: 8;" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tblPendingList" style="-fx-background-color: #ffffff; -fx-background-radius: 5; -fx-border-color: #e5e7eb; -fx-border-radius: 5; -fx-font-size: 13px;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="120.0" text="Mã Giao Dịch (ID)" />
                                        <TableColumn fx:id="colAmount" prefWidth="400.0" text="Số Tiền Nạp (VND)" />
                                        <TableColumn fx:id="colTime" prefWidth="390.0" text="Thời Gian Yêu Cầu" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <Label fx:id="lblNotification" textFill="#d31126">
                                    <font>
                                        <Font name="System Bold" size="13.0" />
                                    </font>
                                </Label>
                                <Button fx:id="btnApprove" mnemonicParsing="false" prefHeight="40.0" prefWidth="180.0" style="-fx-background-color: #cc0c1a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="✔  Duyệt Nạp Tiền">
                                    <font>
                                        <Font name="System Bold" size="14.0" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>