<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right, #fffafa, #fce8e9, #f7d6d8);" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.MyProductController">

    <!-- 1. CỘT SIDEBAR BÊN TRÁI -->
    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-border-color: #f2dce0; -fx-border-width: 0 1 0 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 12, 0, 2, 0);" BorderPane.alignment="CENTER">
            <children>
                <!-- Logo Góc Trái -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="BTL" textFill="#d31126">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text=" AUCTION" textFill="#222222">
                            <font>
                                <Font name="System Regular" size="20.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="4.0" top="4.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>

                <!-- Menu Các Đề Mục Lớn -->
                <VBox spacing="6.0">
                    <padding>
                        <Insets left="12.0" right="12.0" top="18.0" />
                    </padding>
                    <children>
                        <Label text="ĐIỀU HƯỚNG CHÍNH" textFill="#9ca3af">
                            <font>
                                <Font name="System Bold" size="11.5" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="4.0" left="8.0" />
                            </VBox.margin>
                        </Label>

                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#goToMain" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="🏠  Trang chủ">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#goToMyBids" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="🔨  Đấu giá của tôi">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <!-- MỤC ĐANG CHỌN (Sản phẩm của tôi): Đổi màu nền hồng #fce8e9 và chữ đỏ #d31126 in đậm -->
                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: #fce8e9; -fx-background-radius: 5; -fx-text-fill: #d31126; -fx-font-weight: bold; -fx-cursor: hand;" text="📦  Sản phẩm của tôi">
                            <font>
                                <Font name="System Bold" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#goToWallet" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="💳  Ví &amp; Nạp tiền">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <Button alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#goToAccount" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="👤  Tài khoản của tôi">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- Footer Sidebar -->
                <VBox spacing="3.0">
                    <padding>
                        <Insets bottom="20.0" left="24.0" />
                    </padding>
                    <children>
                        <Label text="TEAM 15 © 2026." textFill="#9ca3af">
                            <font>
                                <Font name="System Regular" size="12.5" />
                            </font>
                        </Label>
                        <Label text="Hệ thống đấu giá trực tuyến" textFill="#4b5563">
                            <font>
                                <Font name="System Regular" size="12.5" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- 2. KHU VỰC CHÍNH BÊN PHẢI -->
    <center>
        <VBox style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <children>

                <!-- Header Trên Cùng -->
                <HBox alignment="CENTER_RIGHT" prefHeight="70.0" spacing="18.0" style="-fx-background-color: #ffffff; -fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                    <children>
                        <Button mnemonicParsing="false" onAction="#goToMain" style="-fx-background-color: transparent; -fx-cursor: hand;">
                            <graphic>
                                <SVGPath content="M4 6h16M4 12h16M4 18h16" stroke="#4b5563" strokeWidth="2.0" />
                            </graphic>
                        </Button>

                        <!-- Ô tìm kiếm -->
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="360.0" spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 12 0 12;">
                            <children>
                                <SVGPath content="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" fill="transparent" scaleX="0.85" scaleY="0.85" stroke="#4b5563" strokeWidth="2.0" />
                                <TextField fx:id="txtSearchMyProduct" prefHeight="38.0" promptText="Tìm kiếm trong kho sản phẩm của bạn..." style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #1f2937;" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Regular" size="13.0" />
                                    </font>
                                </TextField>
                            </children>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Icon Thông báo & Menu Dropdown Góc Phải -->
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <SVGPath content="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" fill="transparent" stroke="#4b5563" strokeWidth="1.5" />

                                <MenuButton fx:id="userMenuButton" mnemonicParsing="false" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" text="Người dùng" textFill="#374151">
                                    <graphic>
                                        <SVGPath content="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" fill="transparent" scaleX="0.85" scaleY="0.85" stroke="#d31126" strokeWidth="1.5" />
                                    </graphic>
                                    <font>
                                        <Font name="System Regular" size="13.0" />
                                    </font>
                                    <items>
                                        <MenuItem mnemonicParsing="false" onAction="#goToAccount" text="Tài khoản của tôi" />
                                        <MenuItem mnemonicParsing="false" onAction="#LogoutAction" text="Đăng xuất" />
                                    </items>
                                </MenuButton>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- KHU VỰC NỘI DUNG QUẢN LÝ SẢN PHẨM -->
                <VBox spacing="20.0" style="-fx-background-color: transparent;" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                    </padding>
                    <children>

                        <!-- Tiêu đề & Nút Thêm mới -->
                        <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                            <children>
                                <Label text="Sản phẩm của tôi" textFill="#1f2937">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#goToAddProduct" prefHeight="40.0" style="-fx-background-color: #cc0c1a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 20 0 20;" text="➕  Đăng bán sản phẩm mới">
                                    <font>
                                        <Font size="13.5" />
                                    </font>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Khung trắng bao bọc TableView -->
                        <VBox spacing="15.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 15, 0, 0, 3);" VBox.vgrow="ALWAYS">
                            <padding>
                                <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
                            </padding>
                            <children>

                                <!-- Tabs Phân loại trạng thái (Bộ lọc) -->
                                <HBox spacing="12.0" style="-fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 12 0;">
                                    <children>
                                        <Button mnemonicParsing="false" style="-fx-background-color: #fce8e9; -fx-text-fill: #d31126; -fx-border-color: #cc0c1a; -fx-border-width: 0 0 2 0; -fx-cursor: hand; -fx-background-radius: 0;" text="Tất cả (5)">
                                            <font><Font name="System Bold" size="13.5" /></font>
                                        </Button>
                                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand;" text="Chờ duyệt (1)">
                                            <font><Font name="System Bold" size="13.5" /></font>
                                        </Button>
                                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand;" text="Đang đấu giá (2)">
                                            <font><Font name="System Bold" size="13.5" /></font>
                                        </Button>
                                        <Button mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: #6b7280; -fx-cursor: hand;" text="Đã bán/Kết thúc (2)">
                                            <font><Font name="System Bold" size="13.5" /></font>
                                        </Button>
                                    </children>
                                </HBox>

                                <!-- Bảng danh sách sản phẩm -->
                                <TableView fx:id="tblMyProducts" style="-fx-background-color: transparent; -fx-border-color: #e5e7eb;" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colId" prefWidth="70.0" text="Mã SP" />
                                        <TableColumn fx:id="colName" prefWidth="250.0" text="Tên sản phẩm" />
                                        <TableColumn fx:id="colCategory" prefWidth="130.0" text="Danh mục" />
                                        <TableColumn fx:id="colStartPrice" prefWidth="150.0" text="Giá khởi điểm" />
                                        <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Giá hiện tại" />
                                        <TableColumn fx:id="colStatus" prefWidth="120.0" text="Trạng thái" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>

                            </children>
                        </VBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </center>
</BorderPane>