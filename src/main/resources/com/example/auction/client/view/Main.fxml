<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: #e9ecef;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.MainController">
    <children>
        <!-- 1. THANH HEADER TRÊN CÙNG -->
        <HBox alignment="CENTER_LEFT" layoutX="0.0" layoutY="0.0" prefHeight="70.0" prefWidth="1000.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 5, 0, 0, 2);">
            <padding>
                <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
            </padding>
            <children>
                <Label text="TEAM 15 AUCTION" textFill="#2196F3">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <Region prefWidth="15.0" />

                <!-- Ô tìm kiếm đồng bộ chiều cao 35px -->
                <TextField fx:id="txtSearch" prefHeight="35.0" prefWidth="280.0" promptText="Nhập tên sản phẩm tìm kiếm..." />
                <Button mnemonicParsing="false" onAction="#handleSearch" prefHeight="35.0" prefWidth="75.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🔍 Tìm" />

                <!-- Đẩy cụm nút chức năng sang sát lề phải -->
                <Region HBox.hgrow="ALWAYS" />

                <!-- Cụm 3 nút cho màn hình chưa đăng nhập -->
                <Button mnemonicParsing="false" onAction="#goToAddProduct" prefHeight="35.0" prefWidth="110.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="➕ Đăng bán" />

                <Button mnemonicParsing="false" onAction="#goToLogin" prefHeight="35.0" prefWidth="95.0" style="-fx-background-color: #ffffff; -fx-border-color: #2196F3; -fx-border-radius: 3; -fx-text-fill: #2196F3; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng nhập" />

                <Button mnemonicParsing="false" onAction="#goToSignup" prefHeight="35.0" prefWidth="95.0" style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng ký" />
            </children>
        </HBox>

        <!-- 2. CỘT DANH MỤC BÊN TRÁI (Hộp trắng bo góc đổ bóng) -->
        <VBox layoutX="20.0" layoutY="90.0" prefHeight="490.0" prefWidth="210.0" spacing="12.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 0);">
            <children>
                <Label text="DANH MỤC" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="16.0" />
                    </font>
                </Label>
                <Separator />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: #f8f9fa; -fx-text-fill: #333333; -fx-cursor: hand;" text="📱 Đồ điện tử" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: #f8f9fa; -fx-text-fill: #333333; -fx-cursor: hand;" text="🎨 Hàng sưu tầm" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: #f8f9fa; -fx-text-fill: #333333; -fx-cursor: hand;" text="👗 Thời trang" />
                <Button alignment="BASELINE_LEFT" mnemonicParsing="false" prefHeight="35.0" prefWidth="170.0" style="-fx-background-color: #f8f9fa; -fx-text-fill: #333333; -fx-cursor: hand;" text="🚗 Xe cộ &amp; Khác" />
            </children>
        </VBox>

        <!-- 3. KHU VỰC HIỂN THỊ SẢN PHẨM BÊN PHẢI -->
        <VBox layoutX="250.0" layoutY="90.0" prefHeight="490.0" prefWidth="730.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 20; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 8, 0, 0, 0);">
            <children>
                <Label text="🔥 SẢN PHẨM ĐANG ĐẤU GIÁ" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="18.0" />
                    </font>
                </Label>
                <Separator />
                <ScrollPane fitToWidth="true" prefHeight="410.0" prefWidth="690.0" style="-fx-background-color: transparent; -fx-background: #ffffff; -fx-border-color: transparent;">
                    <content>
                        <FlowPane fx:id="productContainer" hgap="20.0" prefWidth="670.0" style="-fx-background-color: #ffffff; -fx-padding: 10;" vgap="20.0" />
                    </content>
                </ScrollPane>
            </children>
        </VBox>
    </children>
</AnchorPane>