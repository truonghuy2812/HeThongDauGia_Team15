<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: linear-gradient(to bottom right, #fffafa, #fce8e9, #f7d6d8);" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.MainAfterLoginController">

    <!-- 1. CỘT SIDEBAR BÊN TRÁI (CÁC ĐỀ MỤC LỚN) -->
    <left>
        <VBox prefWidth="250.0" style="-fx-background-color: #ffffff; -fx-border-color: #f2dce0; -fx-border-width: 0 1 0 0; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.04), 12, 0, 2, 0);" BorderPane.alignment="CENTER">
            <children>
                <!-- Logo Góc Trái -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" style="-fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="24.0" />
                    </padding>
                    <children>
                        <Label style="-fx-font-weight: bold;" text="BTL" textFill="#d31126">
                            <font>
                                <Font name="System Bold" size="28.0" />
                            </font>
                        </Label>
                        <Label text=" AUCTION" textFill="#222222">
                            <font>
                                <Font name="System Regular" size="20.0" />
                            </font>
                            <HBox.margin>
                                <Insets left="4.0" top="4.0" />
                            </HBox.margin>
                        </Label>
                    </children>
                </HBox>

                <!-- Menu Các Đề Mục Lớn -->
                <VBox spacing="6.0">
                    <padding>
                        <Insets left="12.0" right="12.0" top="18.0" />
                    </padding>
                    <children>
                        <Label text="ĐIỀU HƯỚNG CHÍNH" textFill="#9ca3af">
                            <font>
                                <Font name="System Bold" size="11.5" />
                            </font>
                            <VBox.margin>
                                <Insets bottom="4.0" left="8.0" />
                            </VBox.margin>
                        </Label>

                        <Button fx:id="btnNavHome" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showHomeView" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: #fce8e9; -fx-background-radius: 5; -fx-text-fill: #d31126; -fx-font-weight: bold; -fx-cursor: hand;" text="🏠  Trang chủ">
                            <font>
                                <Font name="System Bold" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <Button fx:id="btnNavMyBids" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showMyBidsView" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="🔨  Đấu giá của tôi">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <Button fx:id="btnNavMyProducts" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showMyProductsView" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="📦  Sản phẩm của tôi">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <Button fx:id="btnNavWallet" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#showWalletView" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="💳  Ví &amp; Nạp tiền">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>

                        <Button fx:id="btnNavAccount" alignment="BASELINE_LEFT" graphicTextGap="15.0" mnemonicParsing="false" onAction="#goToAccount" prefHeight="44.0" prefWidth="226.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="👤  Tài khoản của tôi">
                            <font>
                                <Font name="System Regular" size="13.5" />
                            </font>
                            <padding>
                                <Insets left="16.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>

                <!-- Spacer -->
                <Region VBox.vgrow="ALWAYS" />

                <!-- Footer Sidebar -->
                <VBox spacing="3.0">
                    <padding>
                        <Insets bottom="20.0" left="24.0" />
                    </padding>
                    <children>
                        <Label text="TEAM 15 © 2026." textFill="#9ca3af">
                            <font>
                                <Font name="System Regular" size="12.5" />
                            </font>
                        </Label>
                        <Label text="Hệ thống đấu giá trực tuyến" textFill="#4b5563">
                            <font>
                                <Font name="System Regular" size="12.5" />
                            </font>
                        </Label>
                    </children>
                </VBox>
            </children>
        </VBox>
    </left>

    <!-- 2. KHU VỰC CHÍNH BÊN PHẢI -->
    <center>
        <VBox style="-fx-background-color: transparent;" BorderPane.alignment="CENTER">
            <children>
                <!-- Header Trên Cùng -->
                <HBox alignment="CENTER_RIGHT" prefHeight="70.0" spacing="18.0" style="-fx-background-color: #ffffff; -fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0;">
                    <padding>
                        <Insets left="30.0" right="30.0" />
                    </padding>
                    <children>
                        <Button mnemonicParsing="false" onAction="#showHomeView" style="-fx-background-color: transparent; -fx-cursor: hand;">
                            <graphic>
                                <SVGPath content="M4 6h16M4 12h16M4 18h16" stroke="#4b5563" strokeWidth="2.0" />
                            </graphic>
                        </Button>

                        <!-- Ô tìm kiếm -->
                        <HBox alignment="CENTER_LEFT" prefHeight="40.0" prefWidth="360.0" spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 12 0 12;">
                            <children>
                                <SVGPath content="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" fill="transparent" scaleX="0.85" scaleY="0.85" stroke="#4b5563" strokeWidth="2.0" />
                                <TextField fx:id="txtSearch" onAction="#handleSearch" prefHeight="38.0" promptText="Tìm kiếm sản phẩm..." style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #1f2937;" HBox.hgrow="ALWAYS">
                                    <font>
                                        <Font name="System Regular" size="13.0" />
                                    </font>
                                </TextField>
                            </children>
                            <HBox.margin>
                                <Insets left="10.0" />
                            </HBox.margin>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- Nút Đăng Bán -->
                        <Button mnemonicParsing="false" onAction="#goToAddProduct" prefHeight="40.0" style="-fx-background-color: #cc0c1a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 20 0 20;" text="➕  Đăng bán sản phẩm">
                            <font>
                                <Font size="13.5" />
                            </font>
                        </Button>

                        <!-- Icon Thông báo & Menu Dropdown Góc Phải -->
                        <HBox alignment="CENTER" spacing="15.0">
                            <children>
                                <SVGPath content="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" fill="transparent" stroke="#4b5563" strokeWidth="1.5" />

                                <MenuButton fx:id="userMenuButton" mnemonicParsing="false" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" text="Người dùng" textFill="#374151">
                                    <graphic>
                                        <SVGPath content="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" fill="transparent" scaleX="0.85" scaleY="0.85" stroke="#d31126" strokeWidth="1.5" />
                                    </graphic>
                                    <font>
                                        <Font name="System Regular" size="13.0" />
                                    </font>
                                    <items>
                                        <!-- Bấm vào đây sẽ nhảy sang mục Tài khoản của tôi bên trái -->
                                        <MenuItem mnemonicParsing="false" onAction="#goToAccount" text="Tài khoản của tôi" />
                                        <MenuItem mnemonicParsing="false" onAction="#LogoutAction" text="Đăng xuất" />
                                    </items>
                                </MenuButton>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <!-- VÙNG NỘI DUNG CHUYỂN ĐỔI (TRANG CHỦ / TÀI KHOẢN CỦA TÔI) -->
                <StackPane VBox.vgrow="ALWAYS">
                    <children>

                        <!-- A. MÀN HÌNH DANH SÁCH SẢN PHẨM (TRANG CHỦ) -->
                        <VBox fx:id="homePane" spacing="20.0" style="-fx-background-color: transparent;">
                            <padding>
                                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" prefHeight="50.0">
                                    <children>
                                        <Label fx:id="lblSectionTitle" text="Sản phẩm Đấu giá nổi bật" textFill="#222222">
                                            <font>
                                                <Font name="System Regular" size="24.0" />
                                            </font>
                                        </Label>
                                        <Region HBox.hgrow="ALWAYS" />
                                    </children>
                                </HBox>

                                <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                                    <content>
                                        <FlowPane fx:id="productContainer" hgap="24.0" style="-fx-background-color: transparent;" vgap="24.0" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>

                        <!-- B. MÀN HÌNH TÀI KHOẢN CỦA TÔI (Ẩn mặc định, hiện ra khi bấm nút Tài khoản) -->
                        <VBox fx:id="accountPane" managed="false" spacing="20.0" style="-fx-background-color: transparent;" visible="false">
                            <padding>
                                <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
                            </padding>
                            <children>
                                <Label text="Tài khoản của tôi" textFill="#222222">
                                    <font>
                                        <Font name="System Regular" size="24.0" />
                                    </font>
                                </Label>

                                <HBox spacing="24.0">
                                    <children>
                                        <!-- Hộp trắng thông tin cá nhân đồng bộ login-view -->
                                        <VBox prefWidth="480.0" spacing="18.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 4);">
                                            <padding>
                                                <Insets bottom="30.0" left="32.0" right="32.0" top="30.0" />
                                            </padding>
                                            <children>
                                                <Label text="Hồ sơ cá nhân" textFill="#222222">
                                                    <font>
                                                        <Font name="System Bold" size="18.0" />
                                                    </font>
                                                </Label>

                                                <VBox spacing="6.0">
                                                    <children>
                                                        <Label text="Tên đăng nhập" textFill="#4b5563">
                                                            <font>
                                                                <Font size="13.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtProfileUsername" editable="false" prefHeight="40.0" style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 12 0 12; -fx-text-fill: #1f2937;" text="Người dùng">
                                                            <font>
                                                                <Font size="13.0" />
                                                            </font>
                                                        </TextField>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="6.0">
                                                    <children>
                                                        <Label text="Email liên hệ" textFill="#4b5563">
                                                            <font>
                                                                <Font size="13.0" />
                                                            </font>
                                                        </Label>
                                                        <TextField fx:id="txtProfileEmail" editable="false" prefHeight="40.0" style="-fx-background-color: #f9fafb; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 12 0 12; -fx-text-fill: #1f2937;" text="user@auction.com">
                                                            <font>
                                                                <Font size="13.0" />
                                                            </font>
                                                        </TextField>
                                                    </children>
                                                </VBox>

                                                <Button mnemonicParsing="false" onAction="#showHomeView" prefHeight="40.0" style="-fx-background-color: #cc0c1a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 20 0 20;" text="Quay lại Trang chủ">
                                                    <font>
                                                        <Font size="13.5" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </VBox>

                                        <!-- Hộp trắng Số dư ví đấu giá -->
                                        <VBox prefWidth="360.0" spacing="18.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 4);">
                                            <padding>
                                                <Insets bottom="30.0" left="32.0" right="32.0" top="30.0" />
                                            </padding>
                                            <children>
                                                <Label text="Ví đấu giá của: " textFill="#4b5563">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblAccountUsername" text="Người dùng" textFill="#d31126">
                                                    <font>
                                                        <Font name="System Bold" size="20.0" />
                                                    </font>
                                                </Label>
                                                <Label text="Trạng thái tài khoản: Đã xác thực" textFill="#374151">
                                                    <font>
                                                        <Font size="13.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                    </children>
                </StackPane>
            </children>
        </VBox>
    </center>
</BorderPane>