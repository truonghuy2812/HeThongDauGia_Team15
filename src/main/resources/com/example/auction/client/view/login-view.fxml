<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="650.0" prefWidth="960.0" style="-fx-background-color: #f1f5f9;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.LoginController">
    <children>
        <HBox layoutX="100.0" layoutY="65.0" prefHeight="520.0" prefWidth="760.0" style="-fx-background-color: #ffffff; -fx-background-radius: 20; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.08), 25, 0, 0, 8); -fx-border-radius: 20; -fx-border-color: #e2e8f0; -fx-border-width: 1;">
            <children>

                <!-- Cột trái: Form Đăng nhập -->
                <VBox alignment="CENTER_LEFT" prefHeight="520.0" prefWidth="430.0" spacing="16.0" style="-fx-padding: 40 45 40 45;">
                    <children>
                        <Label styleClass="title-2" text="Đăng Nhập" textFill="#0f172a">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label styleClass="subtle" text="Chào mừng trở lại! Vui lòng nhập thông tin để tiếp tục." textFill="#64748b" wrapText="true">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>

                        <VBox spacing="6.0">
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                            <children>
                                <Label text="Tên tài khoản hoặc Email" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <TextField fx:id="txtUsername" prefHeight="40.0" promptText="Tên đăng nhập..." style="-fx-background-radius: 8;" styleClass="rounded" />
                            </children>
                        </VBox>

                        <VBox spacing="6.0">
                            <children>
                                <Label text="Mật khẩu" textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0" />
                                    </font>
                                </Label>
                                <PasswordField fx:id="txtPassword" prefHeight="40.0" promptText="Mật khẩu của bạn..." style="-fx-background-radius: 8;" styleClass="rounded" />
                            </children>
                        </VBox>

                        <Button fx:id="btnLogin" mnemonicParsing="false" onAction="#handleLogin" prefHeight="42.0" prefWidth="340.0" style="-fx-background-radius: 8; -fx-cursor: hand;" styleClass="accent, large" text="Đăng Nhập">
                            <font>
                                <Font name="System Bold" size="13.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="10.0" />
                            </VBox.margin>
                        </Button>

                        <HBox alignment="CENTER" spacing="5.0">
                            <children>
                                <Label text="Chưa có tài khoản?" textFill="#64748b" />
                                <Hyperlink onAction="#goToRegister" text="Đăng ký ngay" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Cột phải: Banner đồng bộ -->
                <VBox alignment="CENTER" prefHeight="520.0" prefWidth="330.0" spacing="20.0" style="-fx-background-color: linear-gradient(to bottom right, #0284c7, #1e3a8a); -fx-background-radius: 0 20 20 0; -fx-padding: 40;">
                    <children>
                        <Label text="AUCTION PRO" textFill="WHITE">
                            <font>
                                <Font name="System Bold" size="24.0" />
                            </font>
                        </Label>
                        <Label alignment="CENTER" maxWidth="230.0" styleClass="subtle" text="Khám phá hàng ngàn vật phẩm giá trị đang được đấu giá sôi nổi mỗi ngày." textAlignment="CENTER" textFill="#e0f2fe" wrapText="true" />
                        <Region VBox.vgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#goToRegister" style="-fx-background-color: transparent; -fx-border-color: #ffffff; -fx-border-radius: 20; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Tạo tài khoản">
                            <padding>
                                <Insets bottom="8.0" left="22.0" right="22.0" top="8.0" />
                            </padding>
                        </Button>
                    </children>
                </VBox>

            </children>
        </HBox>
    </children>
</AnchorPane>