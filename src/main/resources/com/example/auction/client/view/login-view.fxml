<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #fffafa, #fce8e9, #f7d6d8);" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.LoginController">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- HỘP TRẮNG ĐĂNG NHẬP (CĂN GIỮA TUYỆT ĐỐI) -->
                <VBox alignment="TOP_CENTER" maxWidth="380.0" prefWidth="380.0" spacing="18.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 4);">
                    <padding>
                        <Insets bottom="30.0" left="32.0" right="32.0" top="30.0" />
                    </padding>
                    <children>

                        <!-- Tiêu đề -->
                        <VBox alignment="CENTER" spacing="6.0">
                            <children>
                                <Label text="Đăng nhập" textFill="#222222">
                                    <font>
                                        <Font name="System Regular" size="24.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <Label text="Bạn chưa có tài khoản? " textFill="#374151">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                        <Hyperlink onAction="#goToRegister" style="-fx-padding: 0; -fx-border-color: transparent; -fx-underline: false;" text="Đăng ký ngay" textFill="#d31126">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets bottom="6.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Email / Tài khoản -->
                        <VBox spacing="6.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label text="Email" textFill="#4b5563">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </Label>
                                        <Label text="*" textFill="#d31126">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 12 0 12;">
                                    <children>
                                        <SVGPath content="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z" fill="#4b5563" scaleX="0.9" scaleY="0.9" />
                                        <TextField fx:id="txtUsername" prefHeight="38.0" promptText="Nhập email hoặc tài khoản..." style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #1f2937;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Mật khẩu -->
                        <VBox spacing="6.0">
                            <children>
                                <HBox spacing="3.0">
                                    <children>
                                        <Label text="Mật khẩu" textFill="#4b5563">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </Label>
                                        <Label text="*" textFill="#d31126">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" prefHeight="40.0" spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 12 0 12;">
                                    <children>
                                        <SVGPath content="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2zm3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2zM5 8h6a1 1 0 0 1 1 1v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1z" fill="#4b5563" scaleX="0.9" scaleY="0.9" />
                                        <PasswordField fx:id="txtPassword" prefHeight="38.0" promptText="Nhập mật khẩu..." style="-fx-background-color: transparent; -fx-padding: 0; -fx-text-fill: #1f2937;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="13.0" />
                                            </font>
                                        </PasswordField>
                                        <SVGPath content="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z" fill="#9ca3af" scaleX="0.9" scaleY="0.9" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Nút Đăng nhập -->
                        <Button fx:id="btnLogin" maxWidth="Infinity" mnemonicParsing="false" onAction="#handleLogin" prefHeight="40.0" style="-fx-background-color: #cc0c1a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng nhập">
                            <font>
                                <Font size="14.0" />
                            </font>
                            <VBox.margin>
                                <Insets top="4.0" />
                            </VBox.margin>
                        </Button>

                        <!-- Link Quên mật khẩu -->
                        <HBox alignment="CENTER_LEFT">
                            <children>
                                <Hyperlink style="-fx-padding: 0; -fx-border-color: transparent; -fx-underline: false;" text="Quên mật khẩu?" textFill="#d31126">
                                    <font>
                                        <Font size="12.5" />
                                    </font>
                                </Hyperlink>
                            </children>
                        </HBox>

                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>
