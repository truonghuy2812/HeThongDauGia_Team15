<?xml version="1.0" encoding="UTF-8"?>

        <?import javafx.geometry.Insets?>
        <?import javafx.scene.control.Button?>
        <?import javafx.scene.control.Label?>
        <?import javafx.scene.control.MenuButton?>
        <?import javafx.scene.control.MenuItem?>
        <?import javafx.scene.control.Separator?>
        <?import javafx.scene.control.TextField?>
        <?import javafx.scene.image.ImageView?>
        <?import javafx.scene.layout.BorderPane?>
        <?import javafx.scene.layout.HBox?>
        <?import javafx.scene.layout.Region?>
        <?import javafx.scene.layout.StackPane?>
        <?import javafx.scene.layout.VBox?>
        <?import javafx.scene.shape.SVGPath?>
        <?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #f3f4f6;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.DetailController">

    <!-- PHẦN TOP: THANH ĐIỀU HƯỚNG NẰM NGANG (ĐỒNG BỘ VỚI MAIN AFTER LOGIN) -->
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <!-- TOP BAR CHỨA THÔNG TIN LIÊN HỆ VÀ ĐỒNG HỒ -->
                <HBox alignment="CENTER_LEFT" prefHeight="35.0" style="-fx-background-color: #a30a15; -fx-padding: 0 40 0 40;">
                    <children>
                        <Label graphicTextGap="8.0" text="0976 448 446" textFill="WHITE">
                            <graphic>
                                <SVGPath content="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" fill="WHITE" scaleX="0.7" scaleY="0.7" />
                            </graphic>
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Label graphicTextGap="8.0" text="info@daugiavietnam.vn" textFill="WHITE">
                            <graphic>
                                <SVGPath content="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" fill="transparent" scaleX="0.7" scaleY="0.7" stroke="WHITE" strokeWidth="2.0" />
                            </graphic>
                            <HBox.margin>
                                <Insets left="20.0" />
                            </HBox.margin>
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />

                        <!-- ĐỒNG HỒ REAL-TIME -->
                        <Label fx:id="lblClock" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Consolas', monospace;" text="Đang tải giờ..." />
                    </children>
                </HBox>

                <!-- MAIN NAVIGATION BAR -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 0 40 0 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <!-- LOGO TEAM 15 -->
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="TEAM 15" textFill="#d31126">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Region prefWidth="30.0" />

                        <!-- NÚT ĐIỀU HƯỚNG BÊN TRÁI -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <!-- Nút Quay lại ở đây -->
                                <Button mnemonicParsing="false" onAction="#backToMain" prefHeight="40.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="⬅ Quay lại Trang chủ">
                                    <font>
                                        <Font name="System Bold" size="13.5" />
                                    </font>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- KHU VỰC CHỨC NĂNG CỦA USER SAU LOGIN -->
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>
                                <!-- Nổi bật rằng đang ở trang chi tiết đấu giá -->
                                <Button mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #fce8e9; -fx-background-radius: 5; -fx-text-fill: #d31126; -fx-font-weight: bold; -fx-padding: 0 20 0 20;" text="🔥 Chi tiết Phiên đấu giá">
                                    <font>
                                        <Font size="13.5" />
                                    </font>
                                </Button>

                                <MenuButton mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" text="Người dùng" textFill="#374151">
                                    <graphic>
                                        <SVGPath content="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" fill="transparent" scaleX="0.85" scaleY="0.85" stroke="#d31126" strokeWidth="1.5" />
                                    </graphic>
                                    <font>
                                        <Font name="System Regular" size="13.0" />
                                    </font>
                                    <items>
                                        <!-- Không thêm hàm onAction cho MenuButton ở đây vì màn hình Detail có thể không cần điều hướng tài khoản để tránh rối luồng -->
                                        <MenuItem mnemonicParsing="false" text="👤 Tài khoản của tôi" />
                                        <MenuItem mnemonicParsing="false" text="🚪 Đăng xuất" />
                                    </items>
                                </MenuButton>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- KHU VỰC CHÍNH BÊN DƯỚI -->
    <center>
        <!-- Nội dung Chi tiết Sản phẩm -->
        <VBox alignment="CENTER" spacing="20.0" style="-fx-background-color: #f3f4f6;" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="50.0" left="80.0" right="80.0" top="30.0" />
            </padding>
            <children>

                <!-- Hộp Thẻ Trắng Chứa Thông Tin Sản Phẩm -->
                <HBox spacing="40.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.06), 20, 0, 0, 5);" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                    <children>

                        <!-- CỘT TRÁI: Khung Ảnh Sản Phẩm -->
                        <StackPane prefHeight="450.0" prefWidth="450.0" style="-fx-background-color: #f9fafb; -fx-border-color: #e5e7eb; -fx-border-radius: 8; -fx-background-radius: 8;">
                            <children>
                                <Label text="Hình ảnh sản phẩm" textFill="#9ca3af">
                                    <font>
                                        <Font size="16.0" />
                                    </font>
                                </Label>
                                <ImageView fx:id="imgProduct" fitHeight="420.0" fitWidth="420.0" pickOnBounds="true" preserveRatio="true" />
                            </children>
                        </StackPane>

                        <!-- CỘT PHẢI: Thông Tin & Đặt Giá -->
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                            <children>

                                <!-- Nhãn Danh mục -->
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label fx:id="lblCategory" style="-fx-background-color: #fef2f2; -fx-background-radius: 4; -fx-padding: 6 15 6 15;" text="Đồ điện tử" textFill="#d31126">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <!-- Tên Sản Phẩm -->
                                <Label fx:id="lblProductName" text="Tên sản phẩm đấu giá" textFill="#1f2937" wrapText="true">
                                    <font>
                                        <Font name="System Bold" size="28.0" />
                                    </font>
                                </Label>

                                <!-- Người bán -->
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label text="Người đăng bán:" textFill="#6b7280">
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblSellerName" text="Người dùng" textFill="#1f2937">
                                            <font>
                                                <Font name="System Bold" size="15.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>

                                <!-- Khung Giá Hiện Tại & Thời Gian Còn Lại -->
                                <HBox alignment="CENTER_LEFT" spacing="60.0" style="-fx-background-color: #fff5f5; -fx-border-color: #fecaca; -fx-border-radius: 8; -fx-background-radius: 8; -fx-border-width: 2;">
                                    <padding>
                                        <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
                                    </padding>
                                    <children>
                                        <VBox spacing="6.0">
                                            <children>
                                                <Label text="Giá đấu hiện tại" textFill="#6b7280">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblCurrentPrice" text="5,000,000 VNĐ" textFill="#d31126">
                                                    <font>
                                                        <Font name="System Bold" size="28.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>

                                        <Separator orientation="VERTICAL" prefHeight="55.0" />

                                        <VBox spacing="6.0">
                                            <children>
                                                <Label text="Thời gian còn lại" textFill="#6b7280">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </Label>
                                                <Label fx:id="lblTimeRemaining" text="02:15:30" textFill="#1f2937">
                                                    <font>
                                                        <Font name="System Bold" size="24.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Mô Tả Sản Phẩm -->
                                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Label text="Mô tả chi tiết:" textFill="#374151">
                                            <font>
                                                <Font name="System Bold" size="16.0" />
                                            </font>
                                        </Label>
                                        <Label fx:id="lblDescription" text="Sản phẩm chính hãng, đầy đủ phụ kiện, bảo hành uy tín..." textFill="#4b5563" wrapText="true">
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <Separator style="-fx-padding: 10 0 10 0;" />

                                <!-- Khu Vực Nhập Giá & Nút Bấm -->
                                <VBox spacing="15.0">
                                    <children>
                                        <Label text="Đặt giá của bạn (VNĐ):" textFill="#374151">
                                            <font>
                                                <Font name="System Bold" size="15.0" />
                                            </font>
                                        </Label>

                                        <HBox spacing="15.0">
                                            <children>
                                                <TextField fx:id="txtBidAmount" prefHeight="50.0" promptText="Nhập số tiền cao hơn giá hiện tại..." style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 15 0 15; -fx-font-size: 15px;" HBox.hgrow="ALWAYS">
                                                </TextField>

                                                <Button fx:id="btnPlaceBid" mnemonicParsing="false" onAction="#handlePlaceBid" prefHeight="50.0" prefWidth="200.0" style="-fx-background-color: #d31126; -fx-background-radius: 6; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="🔨  Đặt giá ngay">
                                                    <font>
                                                        <Font size="15.0" />
                                                    </font>
                                                </Button>
                                            </children>
                                        </HBox>

                                        <Button fx:id="btnAutoBid" maxWidth="Infinity" mnemonicParsing="false" onAction="#openAutoBidForm" prefHeight="48.0" style="-fx-background-color: #ffffff; -fx-border-color: #d31126; -fx-border-radius: 6; -fx-background-radius: 6; -fx-border-width: 2; -fx-text-fill: #d31126; -fx-font-weight: bold; -fx-cursor: hand;" text="⚡  Thiết lập Đấu giá tự động (Auto Bid)">
                                            <font>
                                                <Font size="15.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </VBox>

                            </children>
                        </VBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </center>
</BorderPane>
