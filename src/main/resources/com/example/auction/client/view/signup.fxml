<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" style="-fx-background-color: linear-gradient(to bottom right, #fffafa, #fce8e9, #f7d6d8);" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.SignupController">
    <children>
        <VBox alignment="CENTER" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <children>

                <!-- HỘP TRẮNG ĐĂNG KÝ TÀI KHOẢN (CĂN GIỮA TUYỆT ĐỐI) -->
                <VBox alignment="TOP_CENTER" maxWidth="380.0" prefWidth="380.0" spacing="10.0" style="-fx-background-color: #ffffff; -fx-background-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 4);">
                    <padding>
                        <Insets bottom="22.0" left="30.0" right="30.0" top="20.0" />
                    </padding>
                    <children>

                        <!-- Tiêu đề & Dòng chuyển sang Đăng nhập -->
                        <VBox alignment="CENTER" spacing="4.0">
                            <children>
                                <Label text="Đăng ký tài khoản" textFill="#222222">
                                    <font>
                                        <Font name="System Regular" size="22.0" />
                                    </font>
                                </Label>
                                <HBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <Label text="Bạn đã có tài khoản? " textFill="#374151">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Label>
                                        <Hyperlink onAction="#goToLogin" style="-fx-padding: 0; -fx-border-color: transparent; -fx-underline: false;" text="Đăng nhập ngay" textFill="#d31126">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </Hyperlink>
                                    </children>
                                </HBox>
                            </children>
                            <VBox.margin>
                                <Insets bottom="2.0" />
                            </VBox.margin>
                        </VBox>

                        <!-- Họ tên -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="2.0">
                                    <children>
                                        <Label text="Họ tên" textFill="#4b5563">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                        <Label text="*" textFill="#d31126">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <TextField fx:id="txtUsername" prefHeight="34.0" promptText="Điền đầy đủ theo họ tên trên CMND/CCCD" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 10 0 10;">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </TextField>
                            </children>
                        </VBox>

                        <!-- Email -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="2.0">
                                    <children>
                                        <Label text="Email" textFill="#4b5563">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                        <Label text="*" textFill="#d31126">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <TextField fx:id="txtEmail" prefHeight="34.0" promptText="Điền chính xác email để nhận thông tin" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 10 0 10;">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </TextField>
                            </children>
                        </VBox>

                        <!-- Số điện thoại -->
                        <VBox spacing="4.0">
                            <children>
                                <Label text="Số điện thoại" textFill="#4b5563">
                                    <font>
                                        <Font size="12.5" />
                                    </font>
                                </Label>
                                <TextField prefHeight="34.0" promptText="Số điện thoại liên hệ" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 10 0 10;">
                                    <font>
                                        <Font size="12.0" />
                                    </font>
                                </TextField>
                            </children>
                        </VBox>

                        <!-- Mật khẩu -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="2.0">
                                    <children>
                                        <Label text="Mật khẩu" textFill="#4b5563">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                        <Label text="*" textFill="#d31126">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" prefHeight="34.0" spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 10 0 10;">
                                    <children>
                                        <PasswordField fx:id="txtPassword" prefHeight="32.0" promptText="Nhập mật khẩu" style="-fx-background-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </PasswordField>
                                        <SVGPath content="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z" fill="#9ca3af" scaleX="0.85" scaleY="0.85" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Nhập lại mật khẩu -->
                        <VBox spacing="4.0">
                            <children>
                                <HBox spacing="2.0">
                                    <children>
                                        <Label text="Nhập lại mật khẩu" textFill="#4b5563">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                        <Label text="*" textFill="#d31126">
                                            <font>
                                                <Font size="12.5" />
                                            </font>
                                        </Label>
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" prefHeight="34.0" spacing="8.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-padding: 0 10 0 10;">
                                    <children>
                                        <PasswordField fx:id="txtConfirmPassword" prefHeight="32.0" promptText="Xác nhận lại mật khẩu" style="-fx-background-color: transparent; -fx-padding: 0;" HBox.hgrow="ALWAYS">
                                            <font>
                                                <Font size="12.0" />
                                            </font>
                                        </PasswordField>
                                        <SVGPath content="M13.359 11.238C15.06 9.72 16 8 16 8s-3-5.5-8-5.5a7.028 7.028 0 0 0-2.79.588l.77.771A5.944 5.944 0 0 1 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.134 13.134 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755-.165.165-.337.328-.517.486l.708.709z M11.297 9.176a3.5 3.5 0 0 0-4.474-4.474l.823.823a2.5 2.5 0 0 1 2.829 2.829l.822.822zm-2.943 1.299.822.822a3.5 3.5 0 0 1-4.474-4.474l.823.823a2.5 2.5 0 0 0 2.829 2.829z M3.35 5.47c-.18.16-.353.322-.518.487A13.134 13.134 0 0 0 1.172 8l.195.288c.335.48.83 1.12 1.465 1.755C4.121 11.332 5.881 12.5 8 12.5c.716 0 1.39-.133 2.02-.36l.77.772A7.029 7.029 0 0 1 8 13.5C3 13.5 0 8 0 8s.939-1.721 2.641-3.238l.708.709zm10.296 8.884-12-12 .708-.708 12 12-.708.708z" fill="#9ca3af" scaleX="0.85" scaleY="0.85" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Nút Đăng ký -->
                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleRegister" prefHeight="38.0" style="-fx-background-color: #cc0c1a; -fx-background-radius: 5; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng ký">
                            <font>
                                <Font size="13.5" />
                            </font>
                            <VBox.margin>
                                <Insets top="6.0" />
                            </VBox.margin>
                        </Button>

                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</AnchorPane>