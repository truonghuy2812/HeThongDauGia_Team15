<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #e9ecef;" xmlns="http://javafx.com/javafx/11.0.14-internal" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.SignupController">
    <children>
        <VBox alignment="CENTER" layoutX="275.0" layoutY="50.0" prefHeight="500.0" prefWidth="350.0" spacing="15.0" style="-fx-background-color: #ffffff; -fx-padding: 30; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);">
            <children>
                <Label text="ĐĂNG KÝ TÀI KHOẢN" textFill="#333333">
                    <font>
                        <Font name="System Bold" size="22.0" />
                    </font>
                </Label>

                <VBox spacing="5.0">
                    <Label text="Tên đăng nhập:" textFill="#555555" />
                    <TextField fx:id="txtUsername" prefHeight="35.0" promptText="Nhập username..." />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Email:" textFill="#555555" />
                    <TextField fx:id="txtEmail" prefHeight="35.0" promptText="Nhập email..." />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Mật khẩu:" textFill="#555555" />
                    <PasswordField fx:id="txtPassword" prefHeight="35.0" promptText="Nhập mật khẩu..." />
                </VBox>

                <VBox spacing="5.0">
                    <Label text="Nhập lại mật khẩu:" textFill="#555555" />
                    <PasswordField fx:id="txtConfirmPassword" prefHeight="35.0" promptText="Xác nhận mật khẩu..." />
                </VBox>

                <Button mnemonicParsing="false" onAction="#handleRegister" prefHeight="40.0" prefWidth="290.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;" text="Đăng Ký">
                    <VBox.margin>
                        <javafx.geometry.Insets top="10.0" />
                    </VBox.margin>
                </Button>

                <Hyperlink onAction="#goToLogin" text="Đã có tài khoản? Quay lại Đăng nhập" textFill="#2196f3" />
            </children>
        </VBox>
    </children>
</AnchorPane>