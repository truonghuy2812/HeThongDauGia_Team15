<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" style="-fx-background-color: #fce8e9;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.auction.client.controller.AddProductController">

    <!-- PHẦN TOP: THANH ĐIỀU HƯỚNG NẰM NGANG (ĐỒNG NHẤT VỚI MAIN AFTER LOGIN) -->
    <top>
        <VBox BorderPane.alignment="CENTER">
            <children>
                <!-- TOP BAR CHỨA THÔNG TIN LIÊN HỆ VÀ ĐỒNG HỒ -->
                <HBox alignment="CENTER_LEFT" prefHeight="35.0" style="-fx-background-color: #a30a15; -fx-padding: 0 40 0 40;">
                    <children>
                        <Label graphicTextGap="8.0" text="0976 448 446" textFill="WHITE">
                            <graphic>
                                <SVGPath content="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" fill="WHITE" scaleX="0.7" scaleY="0.7" />
                            </graphic>
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Label graphicTextGap="8.0" text="info@daugiavietnam.vn" textFill="WHITE">
                            <graphic>
                                <SVGPath content="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" fill="transparent" scaleX="0.7" scaleY="0.7" stroke="WHITE" strokeWidth="2.0" />
                            </graphic>
                            <HBox.margin>
                                <Insets left="20.0" />
                            </HBox.margin>
                            <font>
                                <Font size="12.0" />
                            </font>
                        </Label>
                        <Region HBox.hgrow="ALWAYS" />

                        <!-- ĐỒNG HỒ REAL-TIME -->
                        <!-- Lưu ý: Cần thêm chức năng ClockUtil vào AddProductController tương tự như MainAfterLogin -->
                        <Label fx:id="lblClock" style="-fx-text-fill: #FFFFFF; -fx-font-size: 14px; -fx-font-weight: bold; -fx-font-family: 'Consolas', monospace;" text="Đang tải giờ..." />
                    </children>
                </HBox>

                <!-- MAIN NAVIGATION BAR -->
                <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-padding: 0 40 0 40; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
                    <children>
                        <!-- LOGO TEAM 15 -->
                        <VBox alignment="CENTER_LEFT">
                            <children>
                                <Label style="-fx-font-weight: bold;" text="TEAM 15" textFill="#d31126">
                                    <font>
                                        <Font name="System Bold" size="24.0" />
                                    </font>
                                </Label>
                            </children>
                        </VBox>

                        <Region prefWidth="30.0" />

                        <!-- NÚT ĐIỀU HƯỚNG BÊN TRÁI -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <!-- Thay vì các nút trang chủ, ta giữ nút Quay lại ở vị trí này cho logic -->
                                <Button fx:id="btnback" mnemonicParsing="false" onAction="#back" prefHeight="40.0" style="-fx-background-color: transparent; -fx-background-radius: 5; -fx-text-fill: #4b5563; -fx-cursor: hand;" text="⬅ Quay lại Trang chủ">
                                    <font>
                                        <Font name="System Bold" size="13.5" />
                                    </font>
                                    <padding>
                                        <Insets left="15.0" right="15.0" />
                                    </padding>
                                </Button>
                            </children>
                        </HBox>

                        <Region HBox.hgrow="ALWAYS" />

                        <!-- KHU VỰC CHỨC NĂNG CỦA USER SAU LOGIN -->
                        <HBox alignment="CENTER_RIGHT" spacing="15.0">
                            <children>

                                <MenuButton fx:id="userMenuButton" mnemonicParsing="false" prefHeight="40.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 5; -fx-background-radius: 5; -fx-cursor: hand;" text="Người dùng" textFill="#374151">
                                    <graphic>
                                        <SVGPath content="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" fill="transparent" scaleX="0.85" scaleY="0.85" stroke="#d31126" strokeWidth="1.5" />
                                    </graphic>
                                    <font>
                                        <Font name="System Regular" size="13.0" />
                                    </font>
                                    <items>
                                        <MenuItem mnemonicParsing="false" text="👤 Tài khoản của tôi" />
                                        <MenuItem mnemonicParsing="false" text="🚪 Đăng xuất" />
                                    </items>
                                </MenuButton>
                            </children>
                        </HBox>
                    </children>
                </HBox>
            </children>
        </VBox>
    </top>

    <!-- KHU VỰC NỘI DUNG CHÍNH -->
    <center>
        <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
            <content>
                <HBox alignment="CENTER" spacing="30.0">
                    <padding>
                        <Insets bottom="50.0" left="40.0" right="40.0" top="40.0" />
                    </padding>
                    <children>
                        <!-- FORM ĐĂNG SẢN PHẨM BÊN TRÁI -->
                        <VBox maxWidth="550.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);" HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
                            </padding>

                            <children>
                                <!-- TIÊU ĐỀ -->
                                <VBox spacing="6.0">
                                    <children>
                                        <Label text="Đăng Bán Sản Phẩm Mới" textFill="#d31126">
                                            <font>
                                                <Font name="System Bold" size="26.0" />
                                            </font>
                                        </Label>
                                        <Label text="Vui lòng điền đầy đủ chi tiết vật phẩm để bắt đầu đấu giá" textFill="#6b7280">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Label>
                                    </children>
                                </VBox>

                                <Separator style="-fx-background-color: transparent; -fx-border-color: #f2dce0; -fx-border-width: 1 0 0 0;" />

                                <!-- TÊN SẢN PHẨM -->
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Tên sản phẩm *" textFill="#374151">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <TextField fx:id="itemName" prefHeight="45.0" promptText="Ví dụ: Đồng hồ Rolex Submariner..." style="-fx-background-color: #ffffff; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-padding: 0 12 0 12;">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextField>
                                    </children>
                                </VBox>

                                <!-- DANH MỤC -->
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Danh mục sản phẩm *" textFill="#374151">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <MenuButton fx:id="menuButton" maxWidth="Infinity" mnemonicParsing="false" prefHeight="45.0" style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 0 12 0 12;" text="--- Chọn loại sản phẩm ---" textFill="#4b5563">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                            <items>
                                                <MenuItem text="Điện thoại &amp; Đồ công nghệ" />
                                                <MenuItem text="Đồ cổ &amp; Bộ sưu tập" />
                                                <MenuItem text="Thời trang &amp; Trang sức" />
                                                <MenuItem text="Khác" />
                                            </items>
                                        </MenuButton>
                                    </children>
                                </VBox>

                                <!-- MÔ TẢ -->
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Mô tả chi tiết" textFill="#374151">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <TextArea fx:id="infoText" prefHeight="120.0" promptText="Mô tả tình trạng, năm sản xuất, xuất xứ..." style="-fx-control-inner-background: #ffffff; -fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6;" wrapText="true">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </TextArea>
                                    </children>
                                </VBox>

                                <!-- CHỌN ẢNH -->
                                <VBox spacing="8.0">
                                    <children>
                                        <Label text="Hình ảnh minh họa *" textFill="#374151">
                                            <font>
                                                <Font name="System Bold" size="14.0" />
                                            </font>
                                        </Label>
                                        <Button fx:id="pickImage" maxWidth="Infinity" mnemonicParsing="false" onAction="#handlePickImage" prefHeight="45.0" style="-fx-background-color: #fce8e9; -fx-border-color: #d31126; -fx-border-style: dashed; -fx-border-width: 2; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-text-fill: #d31126; -fx-font-weight: bold;" text="📸 TẢI ẢNH TỪ MÁY TÍNH (PNG, JPG)">
                                            <font>
                                                <Font size="14.0" />
                                            </font>
                                        </Button>
                                    </children>
                                </VBox>

                                <!-- NÚT LƯU SẢN PHẨM -->
                                <Button fx:id="addProduct" maxWidth="Infinity" mnemonicParsing="false" onAction="#addItem" prefHeight="50.0" style="-fx-background-color: #cc0c1a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;" text="LƯU &amp; TẠO SẢN PHẨM">
                                    <font>
                                        <Font size="15.0" />
                                    </font>
                                    <VBox.margin>
                                        <Insets top="15.0" />
                                    </VBox.margin>
                                </Button>
                            </children>
                        </VBox>

                        <!-- KHUNG XEM TRƯỚC ẢNH BÊN PHẢI -->
                        <VBox alignment="CENTER" maxWidth="550.0" prefWidth="500.0" spacing="20.0" style="-fx-background-color: #ffffff; -fx-background-radius: 12; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.08), 20, 0, 0, 5);" HBox.hgrow="ALWAYS">

                            <padding>
                                <Insets bottom="35.0" left="35.0" right="35.0" top="35.0" />
                            </padding>

                            <children>
                                <Label text="XEM TRƯỚC HÌNH ẢNH SẢN PHẨM" textFill="#d31126">
                                    <font>
                                        <Font name="System Bold" size="18.0" />
                                    </font>
                                </Label>

                                <AnchorPane fx:id="showInfo" maxWidth="Infinity" prefHeight="450.0" style="-fx-background-color: #f9fafb; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #d1d5db; -fx-border-style: dashed; -fx-border-width: 2;" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox alignment="CENTER" spacing="15.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                                            <children>
                                                <Label text="🖼️" textFill="#9ca3af">
                                                    <font>
                                                        <Font size="60.0" />
                                                    </font>
                                                </Label>
                                                <Label text="Chưa có hình ảnh" textFill="#4b5563">
                                                    <font>
                                                        <Font name="System Bold" size="18.0" />
                                                    </font>
                                                </Label>
                                                <Label text="Ảnh tải lên sẽ hiển thị tại khu vực này" textFill="#9ca3af">
                                                    <font>
                                                        <Font size="14.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </VBox>
                                    </children>
                                </AnchorPane>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
