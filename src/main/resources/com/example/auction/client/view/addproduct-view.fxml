<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0"
            style="-fx-background-color: linear-gradient(to bottom right, #fffafa, #fce8e9, #f7d6d8);"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.auction.client.controller.AddProductController">

    <!-- HEADER -->
    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_RIGHT"
              prefHeight="70.0"
              spacing="18.0"
              style="-fx-background-color: #ffffff; -fx-border-color: #f2dce0; -fx-border-width: 0 0 1 0;">

            <padding>
                <Insets left="30.0" right="30.0"/>
            </padding>

            <children>
                <Region HBox.hgrow="ALWAYS"/>

                <!-- THÔNG BÁO -->
                <SVGPath content="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                         fill="transparent"
                         stroke="#4b5563"
                         strokeWidth="1.5"/>

                <!-- NÚT QUAY LẠI -->
                <Button fx:id="btnback"
                        mnemonicParsing="false"
                        onAction="#back"
                        prefHeight="40.0"
                        style="-fx-background-color: #ffffff; -fx-border-color: #d31126; -fx-border-radius: 5; -fx-background-radius: 5; -fx-text-fill: #d31126; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 0 20 0 20;"
                        text="⬅  Quay lại">
                    <font>
                        <Font size="13.0"/>
                    </font>
                </Button>
            </children>
        </HBox>
    </top>

    <!-- KHU VỰC NỘI DUNG CHÍNH -->
    <center>
        <HBox spacing="24.0">

            <padding>
                <Insets bottom="25.0" left="35.0" right="35.0" top="25.0"/>
            </padding>

            <children>

                <!-- FORM ĐĂNG SẢN PHẨM -->
                <VBox prefWidth="460.0"
                      spacing="12.0"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #f2dce0; -fx-border-radius: 10;">

                    <padding>
                        <Insets bottom="22.0" left="25.0" right="25.0" top="22.0"/>
                    </padding>

                    <children>

                        <Label text="Đăng Bán Sản Phẩm Mới"
                               textFill="#d31126">
                            <font>
                                <Font name="System Bold" size="21.0"/>
                            </font>
                        </Label>

                        <Label text="Vui lòng cung cấp chi tiết thông tin vật phẩm đấu giá"
                               textFill="#64748b">
                            <font>
                                <Font size="12.0"/>
                            </font>
                        </Label>

                        <Separator style="-fx-background-color: #f2dce0;"/>

                        <!-- TÊN SẢN PHẨM -->
                        <VBox spacing="5.0">
                            <children>

                                <Label text="Tên sản phẩm *"
                                       textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                                <TextField fx:id="itemName"
                                           prefHeight="38.0"
                                           promptText="Ví dụ: Đồng hồ Rolex Submariner..."
                                           style="-fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6;"/>

                            </children>
                        </VBox>

                        <!-- DANH MỤC -->
                        <VBox spacing="5.0">
                            <children>

                                <Label text="Danh mục sản phẩm *"
                                       textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                                <MenuButton fx:id="menuButton"
                                            mnemonicParsing="false"
                                            prefHeight="38.0"
                                            prefWidth="400.0"
                                            style="-fx-background-color: #ffffff; -fx-border-color: #d1d5db; -fx-border-radius: 6; -fx-background-radius: 6;"
                                            text="Chọn loại sản phẩm">

                                    <items>
                                        <MenuItem text="Điện thoại &amp; Đồ công nghệ"/>
                                        <MenuItem text="Đồ cổ &amp; Bộ sưu tập"/>
                                        <MenuItem text="Thời trang &amp; Trang sức"/>
                                        <MenuItem text="Khác"/>
                                    </items>

                                </MenuButton>

                            </children>
                        </VBox>

                        <!-- MÔ TẢ -->
                        <VBox spacing="5.0">
                            <children>

                                <Label text="Mô tả chi tiết"
                                       textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                                <TextArea fx:id="infoText"
                                          prefHeight="100.0"
                                          promptText="Nhập mô tả đặc điểm sản phẩm..."
                                          wrapText="true"
                                          style="-fx-background-radius: 6; -fx-border-color: #d1d5db; -fx-border-radius: 6;"/>

                            </children>
                        </VBox>

                        <!-- CHỌN ẢNH -->
                        <VBox spacing="5.0">
                            <children>

                                <Label text="Hình ảnh minh họa *"
                                       textFill="#334155">
                                    <font>
                                        <Font name="System Bold" size="12.0"/>
                                    </font>
                                </Label>

                                <Button fx:id="pickImage"
                                        mnemonicParsing="false"
                                        onAction="#handlePickImage"
                                        prefHeight="40.0"
                                        prefWidth="400.0"
                                        style="-fx-background-color: #fffafa; -fx-border-color: #d31126; -fx-border-style: dashed; -fx-border-radius: 6; -fx-background-radius: 6; -fx-cursor: hand; -fx-text-fill: #d31126;"
                                        text="📸  Tải ảnh từ máy tính (PNG, JPG)"/>

                            </children>
                        </VBox>

                        <Region VBox.vgrow="ALWAYS"/>

                        <!-- NÚT LƯU SẢN PHẨM -->
                        <Button fx:id="addProduct"
                                mnemonicParsing="false"
                                onAction="#addItem"
                                prefHeight="44.0"
                                prefWidth="400.0"
                                style="-fx-background-color: #cc0c1a; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 6; -fx-cursor: hand;"
                                text="LƯU &amp; TẠO SẢN PHẨM">

                            <font>
                                <Font size="13.0"/>
                            </font>

                        </Button>

                    </children>
                </VBox>

                <!-- KHUNG XEM TRƯỚC -->
                <VBox alignment="CENTER"
                      spacing="14.0"
                      HBox.hgrow="ALWAYS"
                      style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-border-color: #f2dce0; -fx-border-radius: 10;">

                    <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0"/>
                    </padding>

                    <children>

                        <Label text="XEM TRƯỚC VẬT PHẨM TRƯỚC KHI ĐĂNG"
                               textFill="#d31126">
                            <font>
                                <Font name="System Bold" size="14.0"/>
                            </font>
                        </Label>

                        <AnchorPane fx:id="showInfo"
                                    prefHeight="450.0"
                                    prefWidth="440.0"
                                    style="-fx-background-color: #fffafa; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #f2dce0; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.06), 20, 0, 0, 6);"
                                    VBox.vgrow="ALWAYS">

                            <children>

                                <VBox alignment="CENTER"
                                      spacing="10.0"
                                      AnchorPane.bottomAnchor="0.0"
                                      AnchorPane.leftAnchor="0.0"
                                      AnchorPane.rightAnchor="0.0"
                                      AnchorPane.topAnchor="0.0">

                                    <children>

                                        <Label text="🖼️"
                                               textFill="#d31126">
                                            <font>
                                                <Font size="42.0"/>
                                            </font>
                                        </Label>

                                        <Label text="Chưa có hình ảnh"
                                               textFill="#9ca3af">
                                            <font>
                                                <Font name="System Bold" size="14.0"/>
                                            </font>
                                        </Label>

                                        <Label text="Ảnh tải lên sẽ hiển thị tại khu vực này"
                                               textFill="#cbd5e1">
                                            <font>
                                                <Font size="11.0"/>
                                            </font>
                                        </Label>

                                    </children>
                                </VBox>

                            </children>
                        </AnchorPane>

                    </children>
                </VBox>

            </children>
        </HBox>
    </center>

</BorderPane>